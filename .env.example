# ===== OpenRouter =====
# Lấy key tại https://openrouter.ai/keys
OPENROUTER_API_KEY=

BASE_URL=https://openrouter.ai/api/v1

# Model chat (free). Danh sách model hỗ trợ tools: GET /v1/models?supported_parameters=tools
# Mặc định đề xuất: inclusionai/ling-3.0-flash-fin:free
CHAT_MODEL=inclusionai/ling-3.0-flash-fin:free

# Model embedding. Nếu model không có trong /v1/embeddings → fallback local sentence-transformers.
EMBED_MODEL=nvidia/llama-nemotron-embed-vl-1b-v2:free

# ===== App =====
SESSION_TTL_SECONDS=1800
APP_NAME=tokenrouter-fashion-chatbot
HTTP_REFERER=http://localhost:5173
X_TITLE=Fashion Sales Chatbot

# ===== Admin =====
# Đổi sang chuỗi bí mật dài trước khi demo. Frontend nhập 1 lần, lưu sessionStorage.
ADMIN_TOKEN=change-me-please-use-a-long-random-string

# ===== CORS =====
CORS_ORIGINS=http://localhost:5173,http://localhost:3000